# Everything here is either rebuilt in the image, useless to it, or must
# never be baked into a layer. Secrets are the last category: an .env file
# copied into a build stage stays in that layer even if a later stage
# deletes it.

.env
.env.*
!.env.example

node_modules
.next
out
build
coverage
*.tsbuildinfo

.git
.gitignore
.github
.vercel

Dockerfile
.dockerignore

# Docs and scratch work. Not needed to build, and every megabyte here is a
# megabyte of build context shipped to the daemon on every build.
docs
README.md
BACKLOG.md
CLAUDE.md
tests
scripts

*.log
.DS_Store
Thumbs.db
.idea
.vscode
