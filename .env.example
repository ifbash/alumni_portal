# =============================================================
# Alumni Portal — environment
#
# Copy to .env.local for development, or set these in the Vercel
# project / container environment for a deployment.
#
# Every variable is marked:
#   [required]  the app will not run correctly in production without it
#   [fallback]  has a safe default; only set it to change behaviour
#
# Fixture mode (no DATABASE_URL) needs nothing at all — that is the
# point of it. See src/lib/config.ts.
# =============================================================

# -------------------------------------------------------------
# Runtime mode
# -------------------------------------------------------------

# db | fixture. [fallback: 'db' when DATABASE_URL is set, else 'fixture'.]
# Set it explicitly only to force fixture mode while a database is
# configured — a sales demo against a live college's data is not a demo.
DATA_MODE=""

# -------------------------------------------------------------
# Database  [required in production]
#
# Must be an ap-south-1 (Mumbai) Postgres 15+ instance. India data
# residency is a load-bearing decision: it keeps DPDP cross-border
# transfer out of scope entirely. See CLAUDE.md.
#
# The role in this URL must NOT be a BYPASSRLS role. Row-level security
# is the tenant isolation boundary; a superuser connection walks through
# it without a word.
# -------------------------------------------------------------

DATABASE_URL="postgresql://user:pass@localhost:5432/diet_alumni?schema=public"

# -------------------------------------------------------------
# Tenancy
# -------------------------------------------------------------

# The tenant served when the host carries no usable subdomain —
# localhost, 127.0.0.1 and *.vercel.app preview URLs.
# [fallback: "diet"]
#
# This fallback does not apply in production: an unrecognised host there
# is a misconfigured DNS record or someone probing, and both 404.
DEFAULT_TENANT_SUBDOMAIN="diet"

# -------------------------------------------------------------
# Session  [SESSION_SECRET required in production]
# -------------------------------------------------------------

# openssl rand -base64 32
# Signs the session cookie. Outside fixture mode the app refuses to boot
# without it (src/lib/auth/session.ts). Rotating it logs everyone out.
SESSION_SECRET=""

# [fallback: "alumni_session"] Change only if two portals share a domain.
SESSION_COOKIE_NAME="alumni_session"

# -------------------------------------------------------------
# Email OTP — the primary credential  [required in production]
#
# Mobile is captured and verified at profile completion for recovery and
# WhatsApp. It is never the primary login.
# -------------------------------------------------------------

EMAIL_PROVIDER="resend"           # resend | ses
RESEND_API_KEY=""
AWS_SES_REGION="ap-south-1"
EMAIL_FROM="DIET Connect <noreply@example.ac.in>"

# [fallback: 600] How long a code stays valid, in seconds.
OTP_TTL_SECONDS="600"

# [fallback: 5] Wrong guesses before the code is burned.
OTP_MAX_ATTEMPTS="5"

# Bounce handling is required, not optional. An alumni list imported from
# a lapsed Hoopstr export is full of dead college addresses, and a sender
# reputation burned in week one takes months to rebuild. See CLAUDE.md.
EMAIL_BOUNCE_WEBHOOK_SECRET=""

# -------------------------------------------------------------
# Mobile — recovery and WhatsApp only, never primary auth
# -------------------------------------------------------------

MSG91_AUTH_KEY=""
MSG91_DLT_TEMPLATE_ID=""          # DLT registration is mandatory for Indian SMS

# -------------------------------------------------------------
# WhatsApp Business API
#
# The real comms channel. Email open rates on Indian alumni lists are
# poor; design flows assuming WhatsApp.
# -------------------------------------------------------------

WHATSAPP_PROVIDER="aisensy"
WHATSAPP_API_KEY=""

# -------------------------------------------------------------
# Object storage — ap-south-1, same residency rule as the database
# -------------------------------------------------------------

S3_BUCKET=""
S3_REGION="ap-south-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# -------------------------------------------------------------
# Queue
# -------------------------------------------------------------

# BullMQ. Also where OTPs belong once there is more than one app
# instance — the in-process store in session.ts is correct for fixture
# mode and wrong for anything with two replicas.
REDIS_URL="redis://localhost:6379"

# -------------------------------------------------------------
# Payments — do not enable until FCRA status is confirmed
#
# Donations carry source_country and is_foreign_contribution from day
# one. Taking a foreign contribution without FCRA registration is a
# problem for the college trust, not for us, which is exactly why the
# module stays dark until they confirm.
# -------------------------------------------------------------

RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# -------------------------------------------------------------
# DPDP
# -------------------------------------------------------------

# [fallback: "2026-08-01"] Stamped into every row in consent_records.
# Bump it when the privacy notice text changes — consent recorded against
# an old notice is consent to something the member never read.
PRIVACY_NOTICE_VERSION="2026-08-01"
